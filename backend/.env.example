# Copy to .env and fill in real values. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# Database (docker-compose overrides host to `postgres`; use localhost for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/receipt_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# AI / OCR providers
OPENAI_API_KEY=
GOOGLE_VISION_CREDENTIALS_PATH=

# Storage (Supabase Storage or swap for Firebase Storage config)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=receipts

# CORS - comma-separated origins in production, e.g. https://app.receiptintel.com
CORS_ORIGINS=["*"]
